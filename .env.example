# Use an HTTPS endpoint with CORS enabled for the TV browser runtime.
VITE_API_BASE_URL=https://example.invalid/
# Optional direct stream origin for Samsung AVPlay. Defaults to VITE_API_BASE_URL.
VITE_STREAM_BASE_URL=https://example.invalid/
# Optional direct stream for local player testing.
VITE_TEST_STREAM_URL=http://example.invalid/stream/channel/example